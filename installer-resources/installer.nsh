!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Chào mừng đến với MIA TOOL 2026"
  !define MUI_WELCOMEPAGE_TEXT "Trình hướng dẫn này sẽ cài đặt MIA TOOL 2026 trên máy tính của bạn.$\r$\n$\r$\nHướng dẫn cài đặt:$\r$\n1. Đóng MIA TOOL 2026 nếu ứng dụng đang chạy.$\r$\n2. Nhấn Tiếp để đọc điều khoản và chọn thư mục cài đặt.$\r$\n3. Sau khi hoàn tất, mở ứng dụng từ biểu tượng ngoài Màn hình nền hoặc menu Bắt đầu.$\r$\n$\r$\nMIA TOOL 2026 hỗ trợ tải, quản lý dữ liệu hóa đơn điện tử và lập tờ khai thuế GTGT tham khảo."
  !insertmacro MUI_PAGE_WELCOME
!macroend
