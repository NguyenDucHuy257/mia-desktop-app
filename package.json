{
  "name": "mia-desktop-app",
  "version": "0.1.0",
  "private": true,
  "author": "Nguyễn Đức Huy",
  "description": "MIA WT desktop client for the mia-crawl-service API",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "typecheck": "tsc -b",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/device-identity.cjs && node --check electron/security-policy.cjs && node --check electron/mia-api-client.cjs && node --check electron/account-connection-broker.cjs && node --check electron/job-lifecycle-broker.cjs && node --check electron/python-runtime-client.cjs && node --check electron/offline-runtime-manager.cjs",
    "check:runtime": "python -m unittest discover -s runtime/python/tests -p test_*.py",
    "check:offline-boundary": "node scripts/check-offline-boundary.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "smoke:accounts": "node scripts/account-connections-smoke.mjs",
    "check:renderer-bundle": "node scripts/check-renderer-bundle.mjs",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run check:electron && npm run check:runtime && npm run check:offline-boundary && npm run test && npm run build:web && npm run check:renderer-bundle",
    "prepare:runtime-builder": "python -m pip install --disable-pip-version-check -r runtime/requirements-build.txt",
    "build:runtime:win": "python -m PyInstaller --noconfirm --clean --distpath runtime/dist --workpath runtime/build runtime/mia-runtime.spec",
    "test:runtime:packaged": "node scripts/smoke-packaged-runtime.mjs",
    "package:win": "npm run prepare:runtime-builder && npm run build:runtime:win && npm run test:runtime:packaged && npm run build && electron-builder --win nsis --x64 --publish never",
    "verify": "npm run build",
    "verify:all": "npm run build && npm run test:visual"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "vn.wetech.mia.desktop",
    "productName": "MIA WT",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/dist/mia-runtime",
        "to": "runtime"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
